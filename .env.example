NODE_ENV=production
PORT=3000

# Hostinger MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supplydesk
DB_USER=supplydesk_user
DB_PASSWORD=CHANGE_ME

# Keep uploads outside the public web root.
UPLOAD_DIR=/home/USERNAME/private/supplydesk-uploads

# Long random value. Never put this in frontend code.
ADMIN_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Public origin
PUBLIC_ORIGIN=https://supplydesk.in
